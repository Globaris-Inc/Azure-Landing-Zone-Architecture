# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
!envs/*.tfvars
envs/poc.secret.tfvars
# Bootstrap lock file not needed (one-time local apply — ADR-005).
# Lock files for platform/ and landing-zones/ SHOULD be committed for reproducible CI.
bootstrap/.terraform.lock.hcl
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ALZ provider cache — populated by `terraform init` when the alz provider downloads library data
.alzlib

# Synthetic-layer build artefacts — archive_file output_path target
synthetic/.build/
synthetic/apps/**/node_modules/

# tfsec / checkov / tflint
.tfsec/
.checkov.yaml
.tflint.hcl

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Claude Code — ignore memory and session state, but track the shared workflow
# artifacts (role agents, review-gate hooks, settings) per landing-zone-kit/templates.md.
.claude/*
!.claude/agents/
!.claude/hooks/
!.claude/settings.json

# Secrets — never commit
*.pem
*.pfx
*.key
.env
.env.*
!.env.example

# Plan outputs
*.tfplan
plan.out
