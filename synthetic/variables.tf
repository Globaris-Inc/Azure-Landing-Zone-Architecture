# Purpose: Input variables for the synthetic workload layer.
# Section: 13 — Synthetic Workload & Telemetry Generation
# Last updated: 2026-06-02

# ---------------------------------------------------------------------------
# Kill switch
# ---------------------------------------------------------------------------

variable "enable_synthetic_workload" {
  description = "Master toggle for the synthetic workload layer. When false, every resource in this root module has count=0 and `terraform apply` destroys all synthetic resources in <5 minutes (PROMPT.md §13.6 kill switch)."
  type        = bool
  default     = false
}

# ---------------------------------------------------------------------------
# Subscription & global config
# ---------------------------------------------------------------------------

variable "landingzones_subscription_id" {
  description = "Subscription ID of the Landing Zones subscription where synthetic resources are deployed alongside the existing corp-a1 / corp-a2 / online-p1 workloads."
  type        = string
}

variable "primary_location" {
  description = "Primary Azure region (matches corp-a1 + online-p1 landing zones)."
  type        = string
  default     = "eastus2"
}

variable "secondary_location" {
  description = "Secondary / DR region (matches corp-a2 cold standby)."
  type        = string
  default     = "centralus"
}

variable "org_prefix" {
  description = "Short org prefix used in deterministic resource names — must match the value used by landing-zones/* so data-source lookups resolve."
  type        = string
}

variable "environment" {
  description = "Environment short name (e.g. poc) — must match the value used by landing-zones/*."
  type        = string
}

# ---------------------------------------------------------------------------
# Cross-module references (consumed via data sources)
# ---------------------------------------------------------------------------

variable "platform_law_workspace_id" {
  description = "ARM resource ID of the Platform Log Analytics workspace. Diagnostic settings on synthetic resources stream here so Section 6 Sentinel rules can correlate synthetic telemetry with real signals."
  type        = string
  default     = ""
}

# ---------------------------------------------------------------------------
# 13.3 — Red-team simulator
# ---------------------------------------------------------------------------

variable "red_team_geo_location" {
  description = "Azure region for the impossible-travel west pole — must be outside the §5 approved_sign_in_countries list (US/CA/GB by default) so the §6 blocked-country detection rule has a valid signal."
  type        = string
  default     = "westeurope"
}

variable "honeypot_user_principal_name" {
  description = "Tenant-resident UPN of the disabled honeypot user (e.g. svc-honeypot@<tenant>.onmicrosoft.com). Must be created manually as a Disabled account — see synthetic/README.md §13.3 pre-reqs. Empty string disables the sign-in / impossible-travel red-team scenarios; the storage / KV / public-IP scenarios still ship."
  type        = string
  default     = ""
}

# ---------------------------------------------------------------------------
# 13.4 — Cost-generating patterns
# ---------------------------------------------------------------------------

variable "cost_pattern_vm_size" {
  description = "VM SKU for the oversized-idle cost-optimization candidate. PROMPT.md §13.4 prescribes Standard_D4s_v5 (~$140/mo). Override to D2s_v5 for a cheaper POC (~$70/mo). The Optimization=Candidate tag stays regardless."
  type        = string
  default     = "Standard_D4s_v5"
}

variable "cost_pattern_vm_admin_username" {
  description = "Linux admin username for the cost-pattern VM. Password auth is disabled; an ephemeral SSH key is generated by the tls provider and the private key is exposed as a sensitive output for break-glass console access."
  type        = string
  default     = "synadmin"
}

variable "cost_pattern_budget_amount_usd" {
  description = "Monthly cap (USD) on the synthetic cost-pattern resource group. Deliberately low so it trips on day 1 — PROMPT.md §13.4 calls for a 'budget set deliberately below projected spend on sandbox sub'."
  type        = number
  default     = 1
}

variable "cost_pattern_budget_alert_emails" {
  description = "Email recipients for the deliberately-low cost-pattern budget thresholds (25/50/75/100%). Empty list disables the budget resource. Surfacing this as its own variable (rather than reusing budget_alert_contact_emails) keeps the FinOps alert channel and the synthetic-noise channel separable."
  type        = list(string)
  default     = []
}

# ---------------------------------------------------------------------------
# 13.6 — Cost guardrails
# ---------------------------------------------------------------------------

variable "cost_guardrails_monthly_cap_usd" {
  description = "Subscription budget cap (USD/mo) on Layer=Synthetic spend. Default 150 ≈ $5/day × 30 — the §13.6 PROMPT.md daily cap expressed at the monthly granularity Azure consumption budgets support. Forecasted-100% notification routes to the stop-synthetic-compute runbook via action group webhook."
  type        = number
  default     = 150
}

variable "cost_guardrails_alert_emails" {
  description = "Email recipients for the §13.6 budget Forecasted 50%/100% notifications. Empty list silently skips the action group + budget — the Automation Account + runbooks + weekly schedule still ship for manual operator use."
  type        = list(string)
  default     = []
}

# ---------------------------------------------------------------------------
# Policy exemptions (OQ-029)
# ---------------------------------------------------------------------------

variable "enable_synthetic_policy_exemptions" {
  description = "Create the RG-scoped Waiver policy exemptions for the corp-MG Deny-Public-Endpoints initiative members (StorageDenyPaasPublicIP on the four public synthetic storage accounts, KeyVaultDenyPaasPublicIP on the red-team decoy Key Vault) that cannot be made compliant without breaking the honeypot/security-signal design (OQ-029). Default true; set false only if the synthetic RGs are moved out from under the corp MG or the resources are made private."
  type        = bool
  default     = true
}

# ---------------------------------------------------------------------------
# Tags
# ---------------------------------------------------------------------------

variable "tags" {
  description = "Extra tags merged into every synthetic resource on top of the locals.common_tags baseline (Layer=Synthetic, Lifecycle=Ephemeral, CostCenter=synthetic-poc)."
  type        = map(string)
  default     = {}
}
