# bootstrap/terraform.tfvars.example
# Copy to terraform.tfvars (gitignored) and fill in real values before running.
# NEVER commit terraform.tfvars — it contains subscription and tenant IDs.

# ---------------------------------------------------------------------------
# Required — replace ALL placeholder values before running terraform apply
# ---------------------------------------------------------------------------

tenant_id = "00000000-0000-0000-0000-000000000000"  # az account show --query tenantId -o tsv

# The 5 platform subscription IDs. The OIDC SP is granted Contributor +
# User Access Administrator on each (OQ-008 / ADR-021). Must match the IDs
# passed to platform/management-groups.
management_subscription_id   = "<MANAGEMENT_SUBSCRIPTION_ID>"    # Management sub (also hosts the state backend)
connectivity_subscription_id = "<CONNECTIVITY_SUBSCRIPTION_ID>"  # Connectivity sub (hub/firewall/DNS)
identity_subscription_id     = "<IDENTITY_SUBSCRIPTION_ID>"      # Identity sub (Entra DS, PIM)
security_subscription_id     = "<SECURITY_SUBSCRIPTION_ID>"      # Security sub (Sentinel/Defender/KV)
landingzones_subscription_id = "<LANDINGZONES_SUBSCRIPTION_ID>"  # Shared Landing Zones sub (spokes + synthetic)

github_org  = "your-github-username-or-org"
github_repo = "alz-poc"

# IP allow list for the state Storage Account: ONLY your deployer public IP.
#
# Format rules (Azure Storage ip_rules): a single host must be a BARE IPv4 (a /32
# suffix is rejected); CIDR ranges must be /0-/30 (no /31 or /32). The code strips
# a trailing /32 for you, but bare is the canonical form.
#
# Do NOT add GitHub Actions runner ranges here: they are thousands of rotating
# CIDRs and Azure Storage caps ip_rules at 200. CI runners are allow-listed
# just-in-time by the deploy workflow (manage_runner_ip) instead.
#
# Get your public IP:  curl -s https://api.ipify.org
ip_allow_list = [
  "203.0.113.10",   # your public IP, bare (no /32)
]

# ---------------------------------------------------------------------------
# Optional overrides (defaults are set in variables.tf)
# ---------------------------------------------------------------------------

# primary_location = "eastus2"
# org_prefix       = "globaris"
# kv_soft_delete_retention_days = 90

# tags = {
#   CostCenter = "DEMO-9999"
# }
