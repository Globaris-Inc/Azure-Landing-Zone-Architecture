# envs/poc.secret.tfvars.example
# Copy to poc.secret.tfvars (gitignored) and fill in real values for local runs.
# In CI these values are supplied automatically via GitHub Actions secrets
# as TF_VAR_* environment variables — no file needed in CI.
#
# Local usage:
#   terraform plan \
#     -var-file=../../envs/poc.tfvars \
#     -var-file=../../envs/poc.secret.tfvars
#
# GitHub Actions secrets to configure (Settings → Secrets and variables → Actions):
#   AZURE_TENANT_ID
#   MANAGEMENT_SUBSCRIPTION_ID
#   CONNECTIVITY_SUBSCRIPTION_ID
#   IDENTITY_SUBSCRIPTION_ID
#   SECURITY_SUBSCRIPTION_ID
#   LANDINGZONES_SUBSCRIPTION_ID

tenant_id = "00000000-0000-0000-0000-000000000000"

connectivity_subscription_id = "00000000-0000-0000-0000-000000000001"
management_subscription_id   = "00000000-0000-0000-0000-000000000002"
identity_subscription_id     = "00000000-0000-0000-0000-000000000003"
security_subscription_id     = "00000000-0000-0000-0000-000000000004"
landingzones_subscription_id = "00000000-0000-0000-0000-000000000005"

# Section 7 — FinOps: email for budget threshold + cost anomaly notifications.
budget_alert_contact_emails = ["your-email@example.com"]
