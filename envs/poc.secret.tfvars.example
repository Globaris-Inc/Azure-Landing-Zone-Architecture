# envs/poc.secret.tfvars.example
# Copy to poc.secret.tfvars (gitignored) and fill in real values for local runs.
# In CI these values are supplied automatically via GitHub Actions secrets
# as TF_VAR_* environment variables — no file needed in CI.
#
# Local usage:
#   terraform plan \
#     -var-file=../../envs/poc.tfvars \
#     -var-file=../../envs/poc.secret.tfvars
#
# GitHub Actions secrets to configure (Settings → Secrets and variables → Actions):
#   AZURE_TENANT_ID
#   MANAGEMENT_SUBSCRIPTION_ID
#   CONNECTIVITY_SUBSCRIPTION_ID
#   IDENTITY_SUBSCRIPTION_ID
#   SECURITY_SUBSCRIPTION_ID
#   LANDINGZONES_SUBSCRIPTION_ID

tenant_id = "00000000-0000-0000-0000-000000000000"

connectivity_subscription_id = "00000000-0000-0000-0000-000000000001"
management_subscription_id   = "00000000-0000-0000-0000-000000000002"
identity_subscription_id     = "00000000-0000-0000-0000-000000000003"
security_subscription_id     = "00000000-0000-0000-0000-000000000004"
landingzones_subscription_id = "00000000-0000-0000-0000-000000000005"

# Section 7 — FinOps: email for budget threshold + cost anomaly notifications.
budget_alert_contact_emails = ["your-email@example.com"]

# Section 8 — Security: object ID of the OIDC SP running Terraform (from `az ad sp show`).
terraform_sp_object_id = "00000000-0000-0000-0000-000000000000"

# Section 8 — Security: email for Defender for Cloud security alert notifications.
security_contact_email = "your-email@example.com"

# Section 9 — Landing Zone Spokes: Entra ID admin for SQL Server (Entra-only auth).
# Get the object ID via: az ad user show --id your-email@example.com --query id -o tsv
#                    or: az ad group show --group "DBA-Admins" --query id -o tsv
sql_aad_admin_object_id = "00000000-0000-0000-0000-000000000000"
sql_aad_admin_login     = "your-email@example.com"

# Section 9 — Landing Zone Spokes: hub VNet IDs and firewall IPs.
# Populate from `terraform output -json` in platform/connectivity after first apply.
primary_hub_vnet_id          = "/subscriptions/<conn-sub-id>/resourceGroups/rg-connectivity-primary-globaris-poc/providers/Microsoft.Network/virtualNetworks/vnet-hub-primary-globaris-poc"
primary_hub_vnet_name        = "vnet-hub-primary-globaris-poc"
primary_hub_rg_name          = "rg-connectivity-primary-globaris-poc"
primary_firewall_private_ip  = "10.0.0.4"
secondary_hub_vnet_id        = "/subscriptions/<conn-sub-id>/resourceGroups/rg-connectivity-secondary-globaris-poc/providers/Microsoft.Network/virtualNetworks/vnet-hub-secondary-globaris-poc"
secondary_hub_vnet_name      = "vnet-hub-secondary-globaris-poc"
secondary_hub_rg_name        = "rg-connectivity-secondary-globaris-poc"
secondary_firewall_private_ip = "10.1.0.4"

# Section 9 — Landing Zone Spokes: platform monitoring IDs.
# Populate from `terraform output -json` in platform/management after first apply.
platform_law_workspace_id = "/subscriptions/<mgmt-sub-id>/resourceGroups/rg-management-globaris-poc/providers/Microsoft.OperationalInsights/workspaces/law-platform-globaris-poc"
platform_action_group_id  = "/subscriptions/<mgmt-sub-id>/resourceGroups/rg-management-globaris-poc/providers/Microsoft.Insights/actionGroups/ag-platform-globaris-poc"
