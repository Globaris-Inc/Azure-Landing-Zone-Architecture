# envs/poc.secret.tfvars.example
# Copy to poc.secret.tfvars (gitignored) and fill in real values for local runs.
# In CI these values are supplied automatically via GitHub Actions secrets
# as TF_VAR_* environment variables — no file needed in CI.
#
# Local usage:
#   terraform plan \
#     -var-file=../../envs/poc.tfvars \
#     -var-file=../../envs/poc.secret.tfvars
#
# GitHub Actions secrets to configure (Settings → Secrets and variables → Actions):
#   AZURE_TENANT_ID
#   MANAGEMENT_SUBSCRIPTION_ID
#   CONNECTIVITY_SUBSCRIPTION_ID
#   IDENTITY_SUBSCRIPTION_ID
#   SECURITY_SUBSCRIPTION_ID
#   LANDINGZONES_SUBSCRIPTION_ID

tenant_id = "00000000-0000-0000-0000-000000000000"

connectivity_subscription_id = "00000000-0000-0000-0000-000000000001"
management_subscription_id   = "00000000-0000-0000-0000-000000000002"
identity_subscription_id     = "00000000-0000-0000-0000-000000000003"
security_subscription_id     = "00000000-0000-0000-0000-000000000004"
landingzones_subscription_id = "00000000-0000-0000-0000-000000000005"

# Section 7 — FinOps: email for budget threshold + cost anomaly notifications.
budget_alert_contact_emails = ["your-email@example.com"]

# Section 8 — Security: object ID of the OIDC SP running Terraform (from `az ad sp show`).
terraform_sp_object_id = "00000000-0000-0000-0000-000000000000"

# Section 8 — Security: email for Defender for Cloud security alert notifications.
security_contact_email = "your-email@example.com"

# Section 9 — Landing Zone Spokes: Entra ID admin for SQL Server (Entra-only auth).
# Get the object ID via: az ad user show --id your-email@example.com --query id -o tsv
#                    or: az ad group show --group "DBA-Admins" --query id -o tsv
sql_aad_admin_object_id = "00000000-0000-0000-0000-000000000000"
sql_aad_admin_login     = "your-email@example.com"

# Section 4 — Private DNS + NSG Flow Logs: values populated after platform/connectivity apply.
# private_dns_rg_name is the name of the DNS zone resource group in the Connectivity sub.
private_dns_rg_name = "rg-dns-globaris-poc"

# GUID (customer ID) of the platform Log Analytics workspace.
# Get it with:
#   az monitor log-analytics workspace show \
#     --resource-group rg-management-globaris-poc \
#     --workspace-name law-platform-globaris-poc \
#     --query customerId -o tsv
platform_law_customer_id = "00000000-0000-0000-0000-000000000000"

# Section 9 — Landing Zone Spokes: hub VNet IDs and firewall IPs.
# Populate from `terraform output -json` in platform/connectivity after first apply.
primary_hub_vnet_id          = "/subscriptions/<conn-sub-id>/resourceGroups/rg-connectivity-primary-globaris-poc/providers/Microsoft.Network/virtualNetworks/vnet-hub-primary-globaris-poc"
primary_hub_vnet_name        = "vnet-hub-primary-globaris-poc"
primary_hub_rg_name          = "rg-connectivity-primary-globaris-poc"
primary_firewall_private_ip  = "10.0.0.4"
secondary_hub_vnet_id        = "/subscriptions/<conn-sub-id>/resourceGroups/rg-connectivity-secondary-globaris-poc/providers/Microsoft.Network/virtualNetworks/vnet-hub-secondary-globaris-poc"
secondary_hub_vnet_name      = "vnet-hub-secondary-globaris-poc"
secondary_hub_rg_name        = "rg-connectivity-secondary-globaris-poc"
secondary_firewall_private_ip = "10.1.0.4"

# Section 9 — Landing Zone Spokes: platform monitoring IDs.
# Populate from `terraform output -json` in platform/management after first apply.
platform_law_workspace_id = "/subscriptions/<mgmt-sub-id>/resourceGroups/rg-management-globaris-poc/providers/Microsoft.OperationalInsights/workspaces/law-platform-globaris-poc"
platform_action_group_id  = "/subscriptions/<mgmt-sub-id>/resourceGroups/rg-management-globaris-poc/providers/Microsoft.Insights/actionGroups/ag-platform-globaris-poc"

# Section 5 — Zero Trust + Conditional Access: identity group object IDs.
# These are NOT secrets (they're Entra group object IDs) but are kept here to
# avoid accidentally committing real directory object IDs.
#
# Break-glass emergency-access group — excluded from ALL Conditional Access policies.
# Create via: az ad group create --display-name "Break-Glass Emergency Access" --mail-nickname "break-glass"
# Then: az ad group show --group "Break-Glass Emergency Access" --query id -o tsv
break_glass_group_object_id = "00000000-0000-0000-0000-000000000000"

# Privileged-access group whose members get PIM eligible role assignments.
# Leave as empty string ("") to skip PIM resource creation entirely.
# Create via: az ad group create --display-name "PIM-Privileged-Access" --mail-nickname "pim-privileged"
pim_privileged_group_object_id = "00000000-0000-0000-0000-000000000000"

# PIM activation approver group — members approve role activation requests.
# Leave as empty string ("") to disable approval workflow (self-activate with MFA).
pim_approver_group_object_id = "00000000-0000-0000-0000-000000000000"

# ---------------------------------------------------------------------------
# Section 6 — Defender for Cloud + Sentinel
# ---------------------------------------------------------------------------

# Sentinel incident owner — Entra group object ID. New incidents are auto-assigned
# to this group via an automation rule. Leave empty ("") to skip auto-assign.
# Create via: az ad group create --display-name "Sentinel-SecOps" --mail-nickname "sentinel-secops"
# Then:       az ad group show --group "Sentinel-SecOps" --query id -o tsv
sentinel_owner_group_object_id = ""

# Watchlist seed data. Both default to empty lists; the watchlists themselves
# are not created when their list is empty (no cost, no orphan resources).
# Populate when you have real targets to flag.
vip_user_object_ids = [
  # "00000000-0000-0000-0000-000000000001",  # exec-1
  # "00000000-0000-0000-0000-000000000002",  # exec-2
]

high_value_asset_resource_ids = [
  # "/subscriptions/<lz-sub>/resourceGroups/rg-corp-a1-workload-.../providers/Microsoft.Sql/servers/sql-corp-a1-...",
  # "/subscriptions/<sec-sub>/resourceGroups/rg-security-globaris-poc/providers/Microsoft.KeyVault/vaults/kv-sec-...",
]

# ---------------------------------------------------------------------------
# Section 13.3 — Synthetic red-team simulator
# ---------------------------------------------------------------------------

# Tenant-resident UPN of the disabled honeypot user that the failed-signin-burst
# and impossible-travel scenarios attempt to authenticate as. Leave empty ("")
# to skip the three sign-in red-team CAJs — the storage/KV/public-IP scenarios
# still ship in that case.
#
# One-time manual creation (tenant admin):
#   az ad user create \
#     --display-name "svc-honeypot (Section 13.3)" \
#     --user-principal-name svc-honeypot@<tenant>.onmicrosoft.com \
#     --password '<throwaway>' \
#     --force-change-password-next-sign-in false
#   az ad user update \
#     --id svc-honeypot@<tenant>.onmicrosoft.com \
#     --account-enabled false
honeypot_user_principal_name = ""
